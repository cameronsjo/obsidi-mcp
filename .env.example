# Optional listener bind address. Defaults to loopback; a non-loopback value
# exposes unauthenticated read/write tools and must use a secured reverse proxy.
MCP_BIND_HOST=127.0.0.1

# Optional additional Host authorities and browser Origins for HTTP/SSE.
# Defaults are localhost, 127.0.0.1, and [::1] with the configured HTTP port.
# Hostnames use the configured port; full HTTPS origins default to port 443.
# Wildcards, credentials, paths, and forwarded-header overrides are rejected.
MCP_ALLOWED_HOSTS=
